# Parley — local environment template
#
# Copy to .env.local and fill in. .env.local is gitignored; this template is
# not, which is why it must never contain a real value:
#
#   cp .env.local.example .env.local
#
# Variable names here are the ones the code actually reads. Anything absent is
# either set by the platform (NODE_ENV) or belongs to a manual script, listed at
# the bottom.

# ── Required: database ──────────────────────────────────────────────────────
# From the Supabase dashboard, Project Settings > API. The service-role key
# bypasses row-level security and must stay server-side — never prefix it with
# NEXT_PUBLIC_, which would ship it to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Required: the models ────────────────────────────────────────────────────
# One OpenRouter key drives both calls: the counterpart's streaming turn and
# the debrief's low-temperature JSON pass. The two model overrides are optional
# and default to a sensible pair in lib/openrouter.ts.
OPENROUTER_API_KEY=
OPENROUTER_ROOM_MODEL=
OPENROUTER_DEBRIEF_MODEL=

# ── Required: where this deployment lives ───────────────────────────────────
# Read through lib/site-url.ts. Used for OAuth redirects, share links and the
# OpenRouter referer header, so it has to match the origin actually serving the
# app. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Required: admin surface ─────────────────────────────────────────────────
# Gates /admin and /api/admin/*. A long random string, not a memorable one.
ADMIN_PASSWORD=

# ── Optional: deployment-wide cost ceiling ──────────────────────────────────
# Tokens per UTC day across every user and guest, enforced in lib/usageLimits.ts.
# Guest ids are minted by the browser, so per-user limits alone cannot bound a
# public demo's spend; this does. Defaults to 2000000 when unset. -1 disables.
GLOBAL_DAILY_TOKEN_BUDGET=

# ── Optional: pricing label ─────────────────────────────────────────────────
# /pricing labels its figures "Demo pricing" until this is true. Set it only
# once PLAN_PRICES in lib/plans.ts matches the live Stripe products.
NEXT_PUBLIC_PRICING_LIVE=

# ── Optional: payments ──────────────────────────────────────────────────────
# Billing is inert without these; the app runs and every account reads as free.
# The price ids come from POST /api/stripe/setup-products — see the deployment
# steps in README.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRACTITIONER_MONTHLY=
STRIPE_PRICE_PRACTITIONER_ANNUAL=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=

# ── Optional: transactional email ───────────────────────────────────────────
# Both are needed together. Without them, sends are logged and skipped rather
# than failing, so local development does not need a mail provider.
RESEND_API_KEY=
EMAIL_FROM=

# ── Manual scripts only ─────────────────────────────────────────────────────
# Not read by the app. evals/run.ts and scripts/test-quota.sh use these, and
# both spend real resources and write real rows — point them at a development
# project, never production.
#
#   PARLEY_BASE_URL
#   PARLEY_TEST_USER_ID
#   PARLEY_EVAL_SCENARIO
#   PARLEY_EVAL_COUNTERPART
#   PARLEY_EVAL_LIMIT
